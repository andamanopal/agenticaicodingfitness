<mujoco model="so101_objects_scene">
  <include file="so101.xml"/>
  <include file="workshop_room.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-25"/>
  </visual>

  <worldbody>
    <body name="red_cube" pos="0.25 -0.10 0.015">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube" type="box" size="0.015 0.015 0.015" condim="3" friction="1 .03 .003"
        rgba="0.9 0.1 0.1 1" contype="2" conaffinity="1" solref="0.01 1"/>
    </body>

    <body name="green_cylinder" pos="0.25 0.0 0.03">
      <freejoint name="green_cylinder_joint"/>
      <geom name="green_cylinder" type="cylinder" size="0.015 0.03" condim="3" friction="1 .03 .003"
        rgba="0.1 0.8 0.2 1" contype="2" conaffinity="1" solref="0.01 1"/>
    </body>

    <body name="blue_sphere" pos="0.25 0.10 0.02">
      <freejoint name="blue_sphere_joint"/>
      <geom name="blue_sphere" type="sphere" size="0.02" condim="3" friction="1 .03 .003"
        rgba="0.15 0.3 0.95 1" contype="2" conaffinity="1" solref="0.01 1"/>
    </body>

    <!-- Visual-only target pad: "place the object on the yellow pad" -->
    <geom name="drop_zone" type="box" pos="0.12 0.18 0.0005" size="0.05 0.05 0.0005"
      rgba="1 0.85 0.1 0.5" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
